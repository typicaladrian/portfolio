---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/site';
import Icon from './Icon.astro';
import RedactionVisual from './RedactionVisual.astro';
import TriageVisual from './TriageVisual.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;

// Screenshot is optional: drop src/assets/scheduler.(png|jpg|webp) in to show it.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/scheduler.{png,jpg,webp}', {
  eager: true,
});
const shot = Object.values(shots)[0]?.default;
---

<article id={project.id} class:list={['card', { featured: project.featured }, `v-${project.visual}`]}>
  <div class="visual">
    {project.visual === 'redaction' && <RedactionVisual />}
    {project.visual === 'triage' && <TriageVisual />}
    {project.visual === 'screenshot' && shot && (
      <Image
        src={shot}
        alt={`Screenshot of ${project.title}`}
        widths={[480, 760, 1100]}
        sizes="(max-width: 720px) 100vw, 440px"
        class="shot"
      />
    )}
  </div>

  <div class="content">
    <header>
      <h3>{project.title}</h3>
      <span class="when">{project.when}</span>
    </header>
    <p class="pitch">{project.pitch}</p>
    <ul class="highlights">
      {project.highlights.map((h) => <li>{h}</li>)}
    </ul>
    <ul class="tags" aria-label="Tech stack">
      {project.tags.map((t) => <li>{t}</li>)}
    </ul>
    <div class="links">
      {project.links.map((l) => (
        <a href={l.href} class:list={['btn', { primary: l.primary }]} target="_blank" rel="noopener">
          {l.label === 'GitHub' ? <Icon name="github" size={14} /> : null}
          {l.label}
          <Icon name="external" size={13} />
        </a>
      ))}
    </div>
  </div>
</article>
